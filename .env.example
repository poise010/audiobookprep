# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Merriam-Webster Dictionary API — https://www.dictionaryapi.com/register/index.htm
# (Free tier available — use "Collegiate Dictionary")
MW_API_KEY=your-key-here

# Forvo API — https://api.forvo.com/plans/
# (Paid API; optional but improves name pronunciation coverage)
FORVO_API_KEY=your-key-here

# Behind the Name API — https://www.behindthename.com/api/
# (Free with registration; great for character names)
BTN_API_KEY=your-key-here

# Claude model to use (change to claude-sonnet-4-6 to reduce costs during testing)
CLAUDE_MODEL=claude-opus-4-8
